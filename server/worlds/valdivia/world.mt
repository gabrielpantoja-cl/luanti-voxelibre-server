backend = sqlite3
player_backend = sqlite3
auth_backend = sqlite3
mod_storage_backend = sqlite3
gameid = mineclone2
world_name = valdivia
creative_mode = true
enable_damage = true
enable_pvp = true
static_spawnpoint = 3669.5,-8.5,-3055.5

# ===========================================
# Mods habilitados para Valdivia
# Fuente de verdad para world.mt (override de luanti-valdivia.conf)
# Actualizado: 2026-09-21 — GitOps compliance
# ===========================================

# Core
load_mod_wetlands_fixlight = true
load_mod_wetlands_lastpos = true
load_mod_valdivia_aliases = true
load_mod_valdivia_newplayer = true
load_mod_server_rules = true
load_mod_wetlands_contact = true

# NPCs y musica
load_mod_wetlands_npcs = true
load_mod_wetlands_music = true
load_mod_valdivia_discoteca = true
load_mod_valdivia_spawn_npc = true
load_mod_valdivia_aviso_entrada = true

# Proteccion (solo protector, NO voxelibre_protection)
load_mod_voxelibre_protection = false
load_mod_protector = true

# Anti-grief
load_mod_valdivia_no_explosions = true
load_mod_valdivia_no_zombie_piglin = true

# Vehiculos
load_mod_automobiles_lib = true
load_mod_automobiles_vespa = true
load_mod_automobiles_beetle = true
load_mod_automobiles_motorcycle = true
load_mod_automobiles_buggy = true
load_mod_automobiles_trans_am = true
load_mod_automobiles_roadster = true
load_mod_automobiles_coupe = true
load_mod_automobiles_catrelle = true
load_mod_automobiles_delorean = true

# Utilidades
load_mod_mcl_custom_world_skins = true
load_mod__world_folder_media = true
load_mod_voxelibre_tv = true

# WorldEdit (para enriquecimiento manual del admin)
load_mod_worldedit = true
load_mod_worldedit_commands = true
load_mod_worldedit_shortcommands = true

# Override de luz para monstruos hostiles en calles iluminadas
load_mod_valdivia_mobs_override = true
